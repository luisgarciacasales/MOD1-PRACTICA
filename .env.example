# .env.example — plantilla de configuración de MOD1-PRACTICA
#
# INVARIANTE 3 (secretos manuales): el .env real vive ÚNICAMENTE en
#   mi-pc:~/augmented/services/MOD1-PRACTICA/.env
# Se crea y edita a mano UNA vez copiando este archivo. El skill `deploy`
# nunca lo crea, copia ni sobreescribe. Este ejemplo solo lleva placeholders:
# jamás pongas credenciales reales aquí (este archivo SÍ está versionado).
#
#   ssh mi-pc
#   cd ~/augmented/services/MOD1-PRACTICA && cp .env.example .env && nano .env

# --- Identidad de usuario del contenedor (convención de ~/augmented/services) ---
# Evita que los archivos escritos en data/ queden como root en el host.
UID=1000
GID=1000

# --- PostgreSQL (capa Silver/Gold) ---
# Puerto publicado SOLO en loopback (invariante 4); acceso vía túnel SSH.
POSTGRES_DB=mod1_practica
POSTGRES_USER=mod1
POSTGRES_PASSWORD=CAMBIAME
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Puerto publicado en 127.0.0.1 del servidor (acceso por túnel SSH: make tunnel).
# Separado de POSTGRES_PORT por si 5432 llegara a ocuparse en mi-pc.
POSTGRES_HOST_PORT=5432

# --- Ollama (invariante 5 · ADR-5) ---
# Por defecto se REUSA un Ollama que ya corre en el host, por host-gateway.
# En el servidor del laboratorio ese es `lab-ollama`: NO se levanta uno propio,
# porque dos copias de los mismos modelos no caben en 16 GB de VRAM.
OLLAMA_BASE_URL=http://host.docker.internal:11434
#
# Instalación autocontenida (quien clona el repo y no tiene Ollama):
#   docker compose --profile standalone up -d
#   docker compose --profile standalone exec ollama ollama pull qwen3.5:9b
# y descomenta esta línea en su lugar, para hablar con el servicio del compose:
# OLLAMA_BASE_URL=http://ollama:11434

# --- Modelos (invariante 7: 7-8B cuantizados a 4-bit, async en lotes de 8) ---
#
# OJO: el PRD (§4.2) nombra "Qwen 2.5 / Llama 3", pero esos modelos NO están
# descargados en el lab-ollama compartido (verificado 2026-08-01). Lo que hay
# dentro del presupuesto de VRAM es qwen3.5:9b (9.7B Q4_K_M, ~6 GB). El resto
# del catálogo (gemma4:12b, qwen3:14b, mistral-small:22b) excede la banda de
# 7-8B de la invariante 7 y arriesga los 16 GB de la RTX 5080.
#
# Dos caminos: usar qwen3.5:9b (default, cero descargas) o hacer un
#   ssh mi-pc 'docker exec lab-ollama ollama pull qwen2.5:7b-instruct-q4_K_M'
# para ceñirse a la letra del PRD. Consulta `make ollama` para ver el catálogo.
OLLAMA_MODEL_NER=qwen3.5:9b
OLLAMA_MODEL_MA=qwen3.5:9b
NLP_BATCH_SIZE=8
# Ventana de contexto por llamada. La fija la política FinOps de CLAUDE.md: sin
# declararla, Ollama usa su default (4096 en este servidor) y un prompt mayor se
# trunca EN SILENCIO. Coste medido: +500 MiB de VRAM.
OLLAMA_NUM_CTX=16384

# --- Embeddings (1024 dimensiones, exigido por gold_enriched_news.embedding) ---
# EMBEDDING_BACKEND=sentence_transformers → e5-large local; arrastra torch
#   (~2.5 GB) a la imagen de la app pero es lo que dice el PRD §6.5.
# EMBEDDING_BACKEND=ollama → usa bge-m3, YA presente en lab-ollama y también de
#   1024 dims; elimina torch de la imagen y reusa la GPU compartida.
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# --- INEGI: API de Indicadores (fuente añadida el 2026-08-04) ---
# Token gratuito, requiere registro:
#   https://www.inegi.org.mx/servicios/api_indicadores.html
# Aporta el contexto de actividad económica real —IGAE, desempleo, confianza del
# consumidor— que BANXICO no publica y que es el motor de fondo del riesgo de
# crédito de la banca.
INEGI_TOKEN=CAMBIAME

# --- BANXICO / SIE (fuente 3.5) ---
# Token gratuito, requiere registro: https://www.banxico.org.mx/SieAPIRest/
BANXICO_TOKEN=CAMBIAME

# --- Claude API: redacción del brief ejecutivo (F4) ---
#
# ÚNICA llamada a un modelo comercial en todo el pipeline. Todo el
# procesamiento masivo —NER, sentimiento, M&A, fintech tagging sobre miles de
# noticias— sigue resolviéndose en local contra lab-ollama, a coste cero. Esta
# clave solo alimenta la síntesis narrativa del brief: bajo volumen, alto
# impacto por unidad.
#
# Por qué se decidió así (27-ago-2026): se comparó empíricamente el brief
# generado por mistral-small:22b local contra uno de Claude sobre datos reales
# de GFNORTEO.MX. Con un buen prompt el modelo local hace la síntesis correcta
# y cita las cifras exactas; lo que no replica es el juicio de dominio —saber
# que el deterioro del crédito al consumo aflora en la línea de estimaciones
# preventivas y en qué trimestre se reporta—, y ese juicio es justo lo que
# convierte un brief en algo accionable en vez de una tabla en prosa.
#
# ATENCIÓN: la clave NO va en este archivo. Va en un fichero aparte, fuera de
# todo árbol de repositorio, montado como secreto de Docker:
#
#   ~/augmented/secrets/anthropic_api_key      (chmod 600, dir chmod 700)
#
# Dos razones. (1) Fuera del repo la protección es estructural y no depende de
# que .gitignore siga correcto. (2) Como secreto se monta en /run/secrets en
# vez de inyectarse en el entorno, así que no aparece en `docker inspect`, no
# está en /proc/<pid>/environ y no la heredan los procesos hijo — que es donde
# se filtran las claves en la práctica, no en un `git push`.
#
# Los ocho servicios del laboratorio comparten esa única copia: rotar la clave
# es editar un archivo, no ocho.
#
# Genera la clave en un WORKSPACE DEDICADO con límite de gasto, no con tu clave
# personal ni una de organización: https://console.anthropic.com/settings/keys
# El scoping importa más que el almacenamiento — reduce el impacto de una fuga,
# mientras que guardarla bien solo reduce su probabilidad.

# Modelo del brief. No lo hardcodees en el código: el coste por brief varía ~5x
# entre niveles y conviene poder bajarlo sin desplegar.
ANTHROPIC_MODEL_BRIEF=claude-opus-5

# --- Caché de APIs externas (requests-cache, backend SQLite) ---
REQUESTS_CACHE_PATH=/app/data/cache/requests_cache.sqlite
CACHE_TTL_MARKET_SECONDS=86400     # diario para datos de mercado
CACHE_TTL_MACRO_SECONDS=604800     # semanal para series macro mensuales

# --- Rutas del medallón dentro del contenedor (gitignored en el host) ---
BRONZE_PATH=/app/data/bronze
SILVER_PATH=/app/data/silver
GOLD_PATH=/app/data/gold
FAISS_INDEX_PATH=/app/data/faiss/index.index

# --- Calendario e ingesta ---
MARKET_CALENDAR=XMEX                # calendario BMV para el JOIN temporal
INGEST_TIME_CT=15:30                # batch diario post-cierre
LOG_LEVEL=INFO
