# .env.example — plantilla de configuración de MOD1-PRACTICA
#
# INVARIANTE 3 (secretos manuales): el .env real vive ÚNICAMENTE en
#   mi-pc:~/augmented/services/MOD1-PRACTICA/.env
# Se crea y edita a mano UNA vez copiando este archivo. El skill `deploy`
# nunca lo crea, copia ni sobreescribe. Este ejemplo solo lleva placeholders:
# jamás pongas credenciales reales aquí (este archivo SÍ está versionado).
#
#   ssh mi-pc
#   cd ~/augmented/services/MOD1-PRACTICA && cp .env.example .env && nano .env

# --- Identidad de usuario del contenedor (convención de ~/augmented/services) ---
# Evita que los archivos escritos en data/ queden como root en el host.
UID=1000
GID=1000

# --- PostgreSQL (capa Silver/Gold) ---
# Puerto publicado SOLO en loopback (invariante 4); acceso vía túnel SSH.
POSTGRES_DB=mod1_practica
POSTGRES_USER=mod1
POSTGRES_PASSWORD=CAMBIAME
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Ollama compartido (invariante 5 · ADR-5) ---
# Reusa el contenedor lab-ollama existente vía host-gateway.
# NO levantar un Ollama propio: la VRAM de 16 GB es riesgo alto del PRD.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Modelos (invariante 7: 7-8B cuantizados a 4-bit, async en lotes de 8) ---
OLLAMA_MODEL_NER=qwen2.5:7b-instruct-q4_K_M
OLLAMA_MODEL_MA=llama3.1:8b-instruct-q4_K_M
EMBEDDING_MODEL=intfloat/multilingual-e5-large
NLP_BATCH_SIZE=8

# --- BANXICO / SIE (fuente 3.5) ---
# Token gratuito, requiere registro: https://www.banxico.org.mx/SieAPIRest/
BANXICO_TOKEN=CAMBIAME

# --- Caché de APIs externas (requests-cache, backend SQLite) ---
REQUESTS_CACHE_PATH=/app/data/cache/requests_cache.sqlite
CACHE_TTL_MARKET_SECONDS=86400     # diario para datos de mercado
CACHE_TTL_MACRO_SECONDS=604800     # semanal para series macro mensuales

# --- Rutas del medallón dentro del contenedor (gitignored en el host) ---
BRONZE_PATH=/app/data/bronze
SILVER_PATH=/app/data/silver
GOLD_PATH=/app/data/gold
FAISS_INDEX_PATH=/app/data/faiss/index.index

# --- Calendario e ingesta ---
MARKET_CALENDAR=XMEX                # calendario BMV para el JOIN temporal
INGEST_TIME_CT=15:30                # batch diario post-cierre
LOG_LEVEL=INFO
